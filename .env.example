# The only file you edit for local configuration: copy it to .env.local (git-ignored) and change what you need.
#   cp .env.example .env.local
# Every line is optional; the value shown is what the app uses when the variable is not set.

# API gateway (backend entry point).
VITE_API_BASE_URL=http://localhost:8080

# Google Identity Services web client ID. Leave empty to hide the Google sign-in button.
VITE_GOOGLE_CLIENT_ID=

# true = learning data comes from in-browser mocks; false = HTTP /api/learning/**.
# When unset it is false if VITE_API_BASE_URL is set, otherwise true.
VITE_USE_MOCK_LEARNING=false

# true = the Rocket game runs on an in-browser mock (single player, no login); false = HTTP /api/games/rocket/**.
VITE_USE_MOCK_ROCKET=false

# Supabase storage: host that community images and videos may come from, and the public base URL of the avatars bucket.
VITE_SUPABASE_MEDIA_HOST=kndrsdqzbzsaiuuruqno.supabase.co
VITE_SUPABASE_AVATARS_URL=https://kndrsdqzbzsaiuuruqno.supabase.co/storage/v1/object/public/avatars
